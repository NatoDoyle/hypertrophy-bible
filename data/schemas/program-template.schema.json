{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypertrophy-bible.dev/schemas/program-template.json",
  "title": "ProgramTemplate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "split",
    "days_per_week",
    "sessions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "split": {
      "enum": [
        "full-body",
        "upper-lower",
        "push-pull-legs",
        "body-part",
        "push-pull",
        "other"
      ]
    },
    "days_per_week": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "experience_level": {
      "type": "array",
      "items": {
        "enum": [
          "beginner",
          "intermediate",
          "advanced"
        ]
      }
    },
    "target_population": {
      "type": "string"
    },
    "progression_ref": {
      "type": "string",
      "description": "id of a progression-rule"
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "exercises"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "exercises": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "exercise",
                "sets",
                "rep_range"
              ],
              "properties": {
                "exercise": {
                  "type": "string",
                  "description": "Exercise id or name"
                },
                "sets": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "rep_range": {
                  "type": "string",
                  "description": "e.g. '6-10'"
                },
                "rir": {
                  "type": "string",
                  "description": "Target reps in reserve, e.g. '1-3'"
                },
                "superset_with": {
                  "type": "string",
                  "description": "The id of the exercise this one is paired with as a superset. The generative engine has always emitted this (its bonus-isolation rescue) and the session player consumes it, but the schema forbade it — a declared contract narrower than the real one (lesson 14). Found while adding `cardio`, unrelated to it."
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "cardio": {
      "type": "object",
      "description": "Prescribed conditioning dose and placement, derived from data/guidelines/cardio-concurrent-training.json and the chosen split. Optional: a program generated without the guideline simply omits it.",
      "properties": {
        "steps_per_day": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "sessions_per_week": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "minutes_per_session": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "modality": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "interference": {
              "enum": [
                "none",
                "low",
                "moderate",
                "high"
              ]
            }
          },
          "required": [
            "id",
            "name",
            "interference"
          ],
          "additionalProperties": false
        },
        "structured_modality": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "interference": {
              "enum": [
                "none",
                "low",
                "moderate",
                "high"
              ]
            }
          },
          "required": [
            "id",
            "name",
            "interference"
          ],
          "additionalProperties": false
        },
        "placement": {
          "type": "object",
          "properties": {
            "best_after": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Session names after which hard cardio is safe. EMPTY is a real answer, not a gap: on a 4-day upper/lower every day is a leg day or the day before one, so the honest advice is rest days and walking."
            },
            "avoid_around": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rule": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "best_after",
            "avoid_around"
          ],
          "additionalProperties": false
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_grade": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "steps_per_day",
        "sessions_per_week",
        "minutes_per_session",
        "placement",
        "evidence_grade"
      ],
      "additionalProperties": false
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
